{
  "manifest_version": 3,
  "name": "Codex Session Pusher",
  "version": "1.0.0",
  "description": "Automatically extracts and pushes ChatGPT session tokens to the Codex Rotation Portal.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
