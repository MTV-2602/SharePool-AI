{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30,
      "regions": ["hkg1"]
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/store-maintenance",
      "schedule": "0 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/store",
      "destination": "/index.html"
    }
  ]
}
