{
    "version": 2,
    "buildCommand": "npm run build",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/client/dist/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "database.json"
        }
    },
    "outputDirectory": "client/dist"
}