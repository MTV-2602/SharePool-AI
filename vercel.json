{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "client/dist/**",
          "accounts.json"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/admin-api/(.*)", "dest": "server.js" },
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/assets/(.*)", "dest": "client/dist/assets/$1" },
    { "src": "/(.*\\.(js|css|png|jpg|svg|ico|woff|woff2|ttf|json))", "dest": "client/dist/$1" },
    { "src": "/(.*)", "dest": "client/dist/index.html" }
  ]
}
