# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# Port
PORT=3000

# Admin Credentials (for web login)
ADMIN_EMAIL=team89a6@gmail.com
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=replace_with_long_random_secret

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API URL (for production)
API_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5173

# Allowed User IDs (comma-separated, leave empty for all users)
ALLOWED_USER_IDS=123456789,987654321

# Google Sheet Script URL (for Coursera import)
GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id

# Gmail SMTP (Forgot password)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# MoMo Payment API
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_REQUEST_TYPE=captureWallet

# Store contact links
STORE_CONTACT_ZALO_URL=https://zalo.me/your_zalo
STORE_CONTACT_MESSENGER_URL=https://m.me/your_page

# Supabase Realtime bridge
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_REALTIME_TOPIC_SECRET=replace_with_long_random_secret
STORE_REALTIME_SAFETY_SYNC_MS=90000

# Public store pricing / stock rules
STORE_PACKAGE1_PRICE=30000
STORE_PACKAGE2_PRICE=60000
STORE_PACKAGE3_PRICE=110000
STORE_TOTAL_MIN_DAYS=20
