# ═══════════════════════════════════════════════════════════════════
# 9Router App Environment Variables Template (.env.example)
# Copy file này thành .env.local khi chạy local hoặc trên VPS
# ═══════════════════════════════════════════════════════════════════

# ─── CORE / SERVER CONFIG ──────────────────────────────────────────
PORT=3040
NODE_ENV=production
ADMIN_KEY=your_admin_key_here

# ─── SUPABASE POSTGRES DATABASE (REQUIRED) ─────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AUTHENTICATION / SESSION ──────────────────────────────────────
JWT_SECRET=your_jwt_secret_32_characters_min

# ─── TELEGRAM BOT ALERTS (OPTIONAL) ────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ALLOWED_USER_IDS=your_telegram_chat_ids_comma_separated

# ─── GOOGLE SHEETS / COURSERA SYNC (OPTIONAL) ──────────────────────
COURSERA_SHEET_SCRIPT_URL=your_google_apps_script_url
