# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# Port
PORT=3000

# Admin Credentials (for web login)
ADMIN_EMAIL=team89a6@gmail.com
ADMIN_PASSWORD=your_secure_password_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API URL (for production)
API_URL=http://localhost:3000

# Allowed User IDs (comma-separated, leave empty for all users)
ALLOWED_USER_IDS=123456789,987654321

# Google Sheet Script URL (for Coursera import)
GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
